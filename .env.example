# ---------------------------------------------------------------------------
# Yene AI Support - required server secrets
# ---------------------------------------------------------------------------

# Gemini API key. Read ONLY by server.ts. It is never sent to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Telegram credentials used to forward human-support handoffs to the
# Yene Business Group support agents. Optional - if unset, handoff tickets
# are still stored in memory and logged, just not forwarded to Telegram.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# ---------------------------------------------------------------------------
# Knowledge base gating
# ---------------------------------------------------------------------------
# Hard safety switch. When "true", the AI refuses to produce ANY factual
# claim (including approved articles) and only offers human support.
# Useful as a kill switch if the knowledge base is found to be out of date.
KB_FACTUAL_ANSWERS_ENABLED="true"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Published support hours, e.g. "Mon-Fri 09:00-18:00 EAT, Sat 09:00-13:00 EAT".
#
# ONLY shown to customers when set. The assistant never estimates a response
# time, so leave this blank and the support hours line is simply omitted.
# SUPPORT_HOURS=""

# Maximum live conversations one agent can hold before they count as busy.
# MAX_THREADS_PER_AGENT="3"

# Where the durable JSON stores are written (tickets, live chat, and the
# Section 7 support analytics). Defaults to ./data.
#
# The analytics verification suite sets this to a temporary directory so its
# fixtures never touch real reporting data.
# YENE_DATA_DIR="./data"

# Where the Section 8 audit log is written. Defaults to ./data/support-audit.json.
# The security verification suite redirects this to a temporary directory.
# YENE_AUDIT_FILE="./data/support-audit.json"

# ---------------------------------------------------------------------
# AI write actions (Section 8) - OFF by default, and that is the point.
# ---------------------------------------------------------------------
# The assistant is READ-ONLY for account, billing, subscription, orders,
# inventory, users and permissions. A write is refused unless the operator
# enables it here, the exact scope is allow-listed, AND a human approved that
# specific action.
#
# Leave BOTH unset. The assistant then reads account data and never changes it.
# YENE_AI_WRITE_ENABLED="true"
# YENE_AI_WRITE_SCOPES="billing.refund,inventory.stock"

# ---------------------------------------------------------------------------
# Knowledge base administration
# ---------------------------------------------------------------------------
# Bearer token for the Yene knowledge base admin API (/api/admin/*).
# Authorized Yene administrators send this to create and update articles.
#
# REQUIRED for the admin API to work. If unset, the admin API stays locked
# (it fails closed) and the assistant keeps serving the markdown files as-is.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YENE_KB_ADMIN_TOKEN="CHANGE_ME"

# ---------------------------------------------------------------------------
# Bootstrap accounts (super admin + demo store owner)
# ---------------------------------------------------------------------------
# Two accounts are created on first boot so a fresh clone can be signed into
# without going through sign-up and email verification:
#
#   super admin   super_admin@yene-store.com     admin@123
#   store owner   lumiere_perfume@yene-store.com  lumiere123
#
# Sign in at http://localhost:3000/#/signin with the email OR the username and
# the password. The store owner gets a Trial storefront on first boot.
#
# Passwords are stored as scrypt hashes, never in plain text, and re-running
# never overwrites a password you have since changed.
#
# !! THESE ARE DEVELOPMENT CREDENTIALS. `admin@123` is nine characters and
# !! trivially guessable. In production this seeder refuses to run unless
# !! BOOTSTRAP_ACCOUNTS_ENABLED is "true", so use real accounts and leave it off.
SUPER_ADMIN_EMAIL="super_admin@yene-store.com"
SUPER_ADMIN_PASSWORD="admin@123"
DEMO_OWNER_EMAIL="lumiere_perfume@yene-store.com"
DEMO_OWNER_PASSWORD="lumiere123"
DEMO_OWNER_NAME="Lumiere Perfume"
DEMO_OWNER_BUSINESS="Lumiere Perfume"
DEMO_OWNER_PACKAGE="platinum"
# Must be "true" to seed the accounts above when NODE_ENV=production.
BOOTSTRAP_ACCOUNTS_ENABLED="false"

# ---------------------------------------------------------------------------
# Identity verification (Fayda ID + TIN), all optional
# ---------------------------------------------------------------------------
# Store rental is gated on a verified Fayda ID and TIN number. Without these
# keys, submissions stay "pending-review" for a super admin to approve. They are
# never auto-approved.
#
# Fayda card photos (front and back) are OPTIONAL. The ID number and TIN are not.
# GOOGLE_CLIENT_ID=          # Google Cloud console -> Web application client id
# YOTI_API_KEY=              # from Yoti, for Yoti ID verification
# ETRADE_VERIFY_URL=         # your e-trade / Fayda verification endpoint
# ETRADE_API_KEY=            # its bearer token

# ---------------------------------------------------------------------------
# Sessions and login codes
# ---------------------------------------------------------------------------
# REQUIRED in production (16+ characters). Without it the server refuses to run
# when NODE_ENV=production rather than falling back to an unkeyed hash.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LOGIN_CODE_SECRET=

# ---------------------------------------------------------------------------
# Password reset emails
# ---------------------------------------------------------------------------
# The public origin used to build the link inside a "reset your password" email.
#
# Set this to the address your customers actually reach you on, with NO trailing
# slash:
#     PASSWORD_RESET_BASE_URL="https://www.yene-store.com"
#
# It is deliberately NOT derived from the incoming request's Host header. A link
# built from a spoofed host is a valid reset token delivered to an attacker's
# page, so the origin is configuration and nothing else.
#
# Left unset, it falls back to http://localhost:$PORT, which is correct for
# local development and wrong for anything public.
# PASSWORD_RESET_BASE_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Set to "development" to enable the local demo identity resolver in
# api/support/auth.ts so you can exercise authenticated chat without a real
# identity provider. NEVER set this in production.
AUTH_MODE="development"

# ---------------------------------------------------------------------------
# YENE DELIVERY - map provider
# ---------------------------------------------------------------------------
# The delivery system ships with a built-in straight-line estimator, so it RUNS
# on a machine with no keys at all. That estimator is honest - it reports itself
# as an estimate and never claims to know where a road is.
#
# Set this to enable real road routing and geocoding:
#
#   DELIVERY_MAP_PROVIDER=osrm       OSRM /route/v1        (no key required)
#   DELIVERY_MAP_PROVIDER=nominatim  OpenStreetMap geocoding (no key)
#   DELIVERY_MAP_PROVIDER=maptiler   MapTiler              (key required)
#   DELIVERY_MAP_PROVIDER=google     Google Maps Platform  (key required)
#
# LEAVE IT UNSET and the server prints a warning at boot saying distances are
# estimates. That warning is the point: an operator must never believe they are
# routing along roads when they are not.
# DELIVERY_MAP_PROVIDER=""

# For the hosted providers. Never the browser key - see DELIVERY_*_BROWSER_KEY.
# DELIVERY_MAPTILER_KEY=""
# DELIVERY_GOOGLE_KEY=""

# A BROWSER-RESTRICTED key, served to the front end through
# GET /api/delivery/map/config. The server key above is structurally absent from
# that response, so it cannot leak through the browser.
# DELIVERY_MAPTILER_BROWSER_KEY=""
# DELIVERY_GOOGLE_BROWSER_KEY=""

# Override the endpoints. This is what makes a SELF-HOSTED OSRM or an internal
# Nominatim a supported deployment rather than a fork.
# DELIVERY_ROUTING_BASE_URL="https://router.project-osrm.org"
# DELIVERY_GEOCODING_BASE_URL=""

# Attribution that MUST be displayed when tiles are shown.
# DELIVERY_TILE_URL=""
# DELIVERY_TILE_ATTRIBUTION=""

# ---------------------------------------------------------------------------
# YENE DELIVERY - delivery confirmation secret
# ---------------------------------------------------------------------------
# HMAC secret for the 4-digit door codes. Falls back to LOGIN_CODE_SECRET.
#
# Without it the codes are still verifiable, but only within a single server
# process: a restart invalidates outstanding codes, and a second instance could
# not verify them. The server warns at boot when it is unset.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DELIVERY_PROOF_SECRET=""
# ---------------------------------------------------------------------------
# Section 55 - storage, media, music and renting a store out
# ---------------------------------------------------------------------------
# NONE of this needs a credential to run.
#
# STORAGE QUOTAS are per package and defined in src/platform/storage.ts:
#   Silver 2 GB | Gold 10 GB | Platinum 50 GB | Super 250 GB - 1 TB+
# Usage is MEASURED from data/media/<folder>/<businessId>/ rather than counted
# in a table, so the number on screen cannot disagree with the disk.
#
# UPLOAD limits. Media is sent as base64 (this project has no multipart parser
# and a 64 KB global JSON limit), which costs ~33% overhead. The per-file ceiling
# is enforced server-side from the package, so this only needs to be big enough
# to carry the largest permitted file plus its encoding overhead.
#
# MUSIC. The storefront music library is EMPTY until Yene Business Group adds
# licensed tracks (POST /api/media/music, super admin only). A track with
# licensed:false is never served and never auto-selected. Businesses cannot
# upload their own music: a storefront plays audio to every visitor without
# asking, so the library is operator-supplied for licensing reasons.
#
# No additional environment variables are required for Section 55.